    <worksheet name='KPI 4: Priority Theatre Share'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='master_dashboard_story' name='federated.1nk4yr505mmsnu1b8bbek0ykvqsp' />
          </datasources>
          <datasource-dependencies datasource='federated.1nk4yr505mmsnu1b8bbek0ykvqsp'>
            <column caption='Intervention Theatre calc' datatype='string' name='[Calculation_1599514674651136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [remoteness_group] IN (&quot;Inner Regional&quot;, &quot;Outer Regional&quot;, &quot;Remote / very remote&quot;)&#10;AND [speed_band] IN (&quot;High speed 90-100&quot;, &quot;Very high speed 110+&quot;)&#10;THEN &quot;Regional high-speed roads&quot;&#10;&#10;ELSEIF [remoteness_group] = &quot;Major Cities&quot;&#10;AND [speed_band] IN (&quot;Urban arterial 60-80&quot;, &quot;Local / urban &lt;=50&quot;)&#10;THEN &quot;Major-city urban streets&quot;&#10;&#10;ELSE &quot;Other road contexts&quot;&#10;END' />
            </column>
            <column caption='Priority Theatre Fatalities' datatype='integer' name='[Calculation_1599514740269066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [Calculation_1599514674651136] = &quot;Regional high-speed roads&quot;&#10;OR [Calculation_1599514674651136] = &quot;Major-city urban streets&quot;&#10;THEN [deaths]&#10;END&#10;)' />
            </column>
            <column caption='Priority Theatre Share' datatype='real' default-format='p0.0%' name='[Calculation_1599514740346891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1599514740269066] / SUM([deaths])' />
            </column>
            <column caption='Analysis Window' datatype='string' name='[analysis_window]' role='dimension' type='nominal' />
            <column caption='Deaths' datatype='integer' name='[deaths]' role='measure' type='quantitative' />
            <column-instance column='[analysis_window]' derivation='None' name='[none:analysis_window:nk]' pivot='key' type='nominal' />
            <column caption='Remoteness Group' datatype='string' name='[remoteness_group]' role='dimension' type='nominal' />
            <column caption='Speed Band' datatype='string' name='[speed_band]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1599514740346891]' derivation='User' name='[usr:Calculation_1599514740346891:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1nk4yr505mmsnu1b8bbek0ykvqsp].[none:analysis_window:nk]'>
            <groupfilter function='member' level='[none:analysis_window:nk]' member='&quot;Recent: 2024-Jan 2026&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.1nk4yr505mmsnu1b8bbek0ykvqsp].[none:analysis_window:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.1nk4yr505mmsnu1b8bbek0ykvqsp].[usr:Calculation_1599514740346891:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true'><![CDATA[<[federated.1nk4yr505mmsnu1b8bbek0ykvqsp].[usr:Calculation_1599514740346891:qk]>]]></run>
                <run>Æ&#10;&#10;</run>
                <run bold='true'>in two priority theatres</run>
                <run>Æ&#10;</run>
              </formatted-text>
