            <column caption='Intervention Theatre calc' datatype='string' name='[Calculation_1599514674651136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [remoteness_group] IN (&quot;Inner Regional&quot;, &quot;Outer Regional&quot;, &quot;Remote / very remote&quot;)&#10;AND [speed_band] IN (&quot;High speed 90-100&quot;, &quot;Very high speed 110+&quot;)&#10;THEN &quot;Regional high-speed roads&quot;&#10;&#10;ELSEIF [remoteness_group] = &quot;Major Cities&quot;&#10;AND [speed_band] IN (&quot;Urban arterial 60-80&quot;, &quot;Local / urban &lt;=50&quot;)&#10;THEN &quot;Major-city urban streets&quot;&#10;&#10;ELSE &quot;Other road contexts&quot;&#10;END' />
