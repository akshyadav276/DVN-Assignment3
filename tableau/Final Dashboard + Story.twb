    <worksheet name='06 What If Lives Saved'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>What if targeted action reduced selected deaths?</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#898989' fontname='Benton Sans Book' fontsize='11'>Select a focus area and target reduction to estimate potential lives saved.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='master_dashboard_story' name='federated.1nk4yr505mmsnu1b8bbek0ykvqsp' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='5' caption='Target reduction %' datatype='real' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='0.05'>
              <calculation class='tableau' formula='0.05' />
              <aliases>
                <alias key='0.05' value='5' />
                <alias key='0.10' value='10' />
                <alias key='0.15' value='15' />
                <alias key='0.20' value='20' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nk4yr505mmsnu1b8bbek0ykvqsp'>
            <column caption='Potential lives saved' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1599514726318087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([deaths]) * [Parameters].[Parameter 1], 0)' />
            </column>
            <column caption='Analysis Window' datatype='string' name='[analysis_window]' role='dimension' type='nominal' />
            <column caption='Deaths' datatype='integer' name='[deaths]' role='measure' type='quantitative' />
            <column caption='Intervention Theatre' datatype='string' name='[intervention_theatre]' role='dimension' type='nominal' />
            <column-instance column='[analysis_window]' derivation='None' name='[none:analysis_window:nk]' pivot='key' type='nominal' />
            <column-instance column='[intervention_theatre]' derivation='None' name='[none:intervention_theatre:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1599514726318087]' derivation='User' name='[usr:Calculation_1599514726318087:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1nk4yr505mmsnu1b8bbek0ykvqsp].[none:analysis_window:nk]'>
            <groupfilter function='member' level='[none:analysis_window:nk]' member='&quot;Recent: 2024-Jan 2026&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1nk4yr505mmsnu1b8bbek0ykvqsp].[none:intervention_theatre:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:intervention_theatre:nk]' member='&quot;Major-city urban streets&quot;' />
              <groupfilter function='member' level='[none:intervention_theatre:nk]' member='&quot;Regional high-speed roads&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.1nk4yr505mmsnu1b8bbek0ykvqsp].[none:analysis_window:nk]</column>
            <column>[federated.1nk4yr505mmsnu1b8bbek0ykvqsp].[none:intervention_theatre:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
