    <worksheet name='05 Timing Heatmap'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Timing Heatmap</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#898989' fontname='Benton Sans Book' fontsize='11'>Fatalities concentrate in routine daytime travel, not only late-night risk</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='master_dashboard_story' name='federated.1nk4yr505mmsnu1b8bbek0ykvqsp' />
          </datasources>
          <datasource-dependencies datasource='federated.1nk4yr505mmsnu1b8bbek0ykvqsp'>
            <column caption='total death' datatype='integer' name='[Calculation_1599514675146754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([deaths])' />
            </column>
            <column caption='Time Band Short' datatype='string' name='[Calculation_1599514722979846]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [time_band]&#10;WHEN &quot;Late night 00-05&quot; THEN &quot;Late night&quot;&#10;WHEN &quot;Morning commute 06-08&quot; THEN &quot;Morning&quot;&#10;WHEN &quot;Daytime 09-15&quot; THEN &quot;Daytime&quot;&#10;WHEN &quot;Evening commute 16-18&quot; THEN &quot;Evening&quot;&#10;WHEN &quot;Night 19-23&quot; THEN &quot;Night&quot;&#10;ELSE [time_band]&#10;END' />
            </column>
            <column caption='Analysis Window' datatype='string' name='[analysis_window]' role='dimension' type='nominal' />
            <column caption='Dayweek' datatype='string' name='[dayweek]' role='dimension' type='nominal' />
            <column caption='Deaths' datatype='integer' name='[deaths]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1599514722979846]' derivation='None' name='[none:Calculation_1599514722979846:nk]' pivot='key' type='nominal' />
            <column-instance column='[analysis_window]' derivation='None' name='[none:analysis_window:nk]' pivot='key' type='nominal' />
            <column-instance column='[dayweek]' derivation='None' name='[none:dayweek:nk]' pivot='key' type='nominal' />
            <column caption='Time Band' datatype='string' name='[time_band]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1599514675146754]' derivation='User' name='[usr:Calculation_1599514675146754:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.1nk4yr505mmsnu1b8bbek0ykvqsp].[none:Calculation_1599514722979846:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Late night&quot;</bucket>
