            <customized-label>
              <formatted-text>
                <run bold='true' fontcolor='#ffbe7d' fontsize='36'><![CDATA[<[federated.1nk4yr505mmsnu1b8bbek0ykvqsp].[usr:Calculation_1599514740346891:qk]>]]></run>
                <run>Æ&#10;</run>
