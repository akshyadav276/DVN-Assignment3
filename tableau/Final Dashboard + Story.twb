      </connection>
      <aliases enabled='yes' />
      <column caption='Intervention Theatre calc' datatype='string' name='[Calculation_1599514674651136]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [remoteness_group] IN (&quot;Inner Regional&quot;, &quot;Outer Regional&quot;, &quot;Remote / very remote&quot;)&#10;AND [speed_band] IN (&quot;High speed 90-100&quot;, &quot;Very high speed 110+&quot;)&#10;THEN &quot;Regional high-speed roads&quot;&#10;&#10;ELSEIF [remoteness_group] = &quot;Major Cities&quot;&#10;AND [speed_band] IN (&quot;Urban arterial 60-80&quot;, &quot;Local / urban &lt;=50&quot;)&#10;THEN &quot;Major-city urban streets&quot;&#10;&#10;ELSE &quot;Other road contexts&quot;&#10;END' />
      </column>
      <column caption='Policy Target Group calc' datatype='string' name='[Calculation_1599514674884609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [intervention_theatre] = &quot;Regional high-speed roads&quot;&#10;AND [road_user_group] = &quot;Vehicle occupant&quot;&#10;THEN &quot;Regional occupants&quot;&#10;&#10;ELSEIF [intervention_theatre] = &quot;Major-city urban streets&quot;&#10;AND [road_user_group] = &quot;Vulnerable road user&quot;&#10;THEN &quot;Urban vulnerable users&quot;&#10;&#10;ELSE &quot;Other / mixed users&quot;&#10;END' />
      </column>
      <column caption='total death' datatype='integer' name='[Calculation_1599514675146754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([deaths])' />
      </column>
      <column caption='Fatalities per 100k' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1599514711142404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([deaths]) / AVG([population]) * 100000' />
      </column>
      <column caption='Avg Population Tooltip' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1599514716209157]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([population])' />
      </column>
      <column caption='Time Band Short' datatype='string' name='[Calculation_1599514722979846]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [time_band]&#10;WHEN &quot;Late night 00-05&quot; THEN &quot;Late night&quot;&#10;WHEN &quot;Morning commute 06-08&quot; THEN &quot;Morning&quot;&#10;WHEN &quot;Daytime 09-15&quot; THEN &quot;Daytime&quot;&#10;WHEN &quot;Evening commute 16-18&quot; THEN &quot;Evening&quot;&#10;WHEN &quot;Night 19-23&quot; THEN &quot;Night&quot;&#10;ELSE [time_band]&#10;END' />
      </column>
      <column caption='Potential lives saved' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1599514726318087]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([deaths]) * [Parameters].[Parameter 1], 0)' />
      </column>
      <column caption='Change 2024 to 2025' datatype='integer' name='[Calculation_1599514739404808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [year] = 2025 THEN [deaths] END)&#10;-&#10;SUM(IF [year] = 2024 THEN [deaths] END)' />
      </column>
      <column caption='Priority Theatre Fatalities' datatype='integer' name='[Calculation_1599514740269066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [Calculation_1599514674651136] = &quot;Regional high-speed roads&quot;&#10;OR [Calculation_1599514674651136] = &quot;Major-city urban streets&quot;&#10;THEN [deaths]&#10;END&#10;)' />
      </column>
      <column caption='Priority Theatre Share' datatype='real' default-format='p0.0%' name='[Calculation_1599514740346891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1599514740269066] / SUM([deaths])' />
      </column>
      <column caption='State Risk Rank' datatype='integer' name='[Calculation_2029561422368769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE([Calculation_1599514711142404], &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Pct Change 2024 to 2025' datatype='real' default-format='p0.0%' name='[Calculation_2029561431556098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    SUM(IF [year] = 2025 THEN [deaths] END)&#10;    -&#10;    SUM(IF [year] = 2024 THEN [deaths] END)&#10;)&#10;/&#10;SUM(IF [year] = 2024 THEN [deaths] END)' />
      </column>
      <column caption='Pct Change Label' datatype='string' name='[Calculation_2029561434124291]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2029561431556098] &gt; 0 THEN&#10;    &quot;+&quot; + STR(ROUND([Calculation_2029561431556098] * 100, 1)) + &quot;%&quot;&#10;ELSE&#10;    STR(ROUND([Calculation_2029561431556098] * 100, 1)) + &quot;%&quot;&#10;END' />
      </column>
      <column caption='Pct Change Direction Label' datatype='string' name='[Calculation_2029561434173444]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2029561431556098] &gt; 0 THEN&#10;    &quot;2025 increase from 2024&quot;&#10;ELSEIF [Calculation_2029561431556098] &lt; 0 THEN&#10;    &quot;2025 decrease from 2024&quot;&#10;ELSE&#10;    &quot;No change from 2024&quot;&#10;END' />
      </column>
      <column caption='Highest State Risk per 100k' datatype='real' name='[Calculation_2029561438015493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX([Calculation_1599514711142404])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='State Year Fatalities' datatype='integer' name='[Calculation_2029561438212102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [state], [year] : SUM([deaths]) }' />
      </column>
      <column caption='State Year Population' datatype='real' name='[Calculation_2029561438314503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [state], [year] : AVG([population]) }' />
      </column>
      <column caption='State Year Fatalities per 100k' datatype='real' name='[Calculation_2029561438371848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2029561438212102] / [Calculation_2029561438314503] * 100000' />
      </column>
      <column caption='Highest Recent State Risk per 100k' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2029561438441481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [state] :&#10;    SUM(&#10;        IF [full_recent_year] = &quot;2024-2025 full years&quot;&#10;        THEN [deaths]&#10;        END&#10;    )&#10;}&#10;/&#10;{ FIXED [state] :&#10;    AVG(&#10;        IF [full_recent_year] = &quot;2024-2025 full years&quot;&#10;        THEN [population]&#10;        END&#10;    )&#10;}&#10;* 100000' />
      </column>
