            <customized-label>
              <formatted-text>
                <run bold='true' fontsize='36'><![CDATA[<[federated.1nk4yr505mmsnu1b8bbek0ykvqsp].[max:Calculation_2029561438441481:qk]>]]></run>
                <run>Æ&#10;</run>
